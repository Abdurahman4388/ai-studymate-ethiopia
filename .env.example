# ==============================================================================
# AI StudyMate Ethiopia - Master Environment Configuration Template
# Copy this file to .env in backend/ and frontend/ as indicated.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration
# ------------------------------------------------------------------------------
PROJECT_NAME="AI StudyMate Ethiopia"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Server Host & Port
HOST="127.0.0.1"
PORT=8000

# Security & Authentication
# Generate a secure key using: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY="change_this_to_a_super_secret_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration (PostgreSQL)
# Note: Update credentials according to your local PostgreSQL setup
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="ai_studymate_db"
DATABASE_URL="postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}"

# CORS (Frontend Origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# File Storage Configuration
STORAGE_TYPE="local" # "local" or "s3"
LOCAL_STORAGE_PATH="storage/uploads"
MAX_UPLOAD_SIZE_MB=25

# AI Provider Configuration
# Supported providers: "mock" (offline dev), "gemini" (Google AI Studio), "openai"
AI_PROVIDER="mock"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# ------------------------------------------------------------------------------
# Frontend Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000/api/v1"
NEXT_PUBLIC_APP_NAME="AI StudyMate Ethiopia"
NEXT_PUBLIC_DEFAULT_LOCALE="en"
